<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Compare income tax liability between old and new Indian tax regimes for FY 2024-25">
  <title>Indian Income Tax Calculator - Compare Old vs New Regime</title>
  <link rel="stylesheet" href="src/ui/styles/main.css">
  <link rel="stylesheet" href="src/ui/styles/figma-design.css">
</head>
<body>
  <div id="app">
    <!-- Header -->
    <header class="site-header" role="banner">
      <div class="header-container">
        <div class="logo">
          <span class="logo-icon">📊</span>
          <span class="logo-text">Tax Calculator</span>
        </div>
        <nav class="main-nav" aria-label="Main navigation">
          <a href="#calculator" class="nav-link active">Calculator</a>
          <a href="#comparison" class="nav-link">Old vs New Regime</a>
          <a href="#guide" class="nav-link">Tax Guide</a>
          <a href="#about" class="nav-link">About</a>
        </nav>
        <a href="#how-it-works" class="cta-button">
          <span class="cta-icon">💡</span>
          How it works
        </a>
      </div>
    </header>

    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-container">
        <h1 class="hero-title">Calculate Your <span class="gradient-text">Income Tax</span></h1>
        <p class="hero-subtitle">Compare Old vs New Tax Regime and save more</p>
      </div>
    </section>

    <!-- Step Indicator -->
    <div class="steps-indicator">
      <div class="steps-container">
        <div class="step active" data-step="1">
          <div class="step-circle">1</div>
          <div class="step-label">
            <span class="step-title">Regime</span>
            <span class="step-desc">Choose Tax Regime</span>
          </div>
        </div>
        <div class="step-line"></div>
        <div class="step" data-step="2">
          <div class="step-circle">2</div>
          <div class="step-label">
            <span class="step-title">Income</span>
            <span class="step-desc">Enter Your Income</span>
          </div>
        </div>
        <div class="step-line"></div>
        <div class="step" data-step="3">
          <div class="step-circle">3</div>
          <div class="step-label">
            <span class="step-title">Deductions</span>
            <span class="step-desc">Add Deductions</span>
          </div>
        </div>
        <div class="step-line"></div>
        <div class="step" data-step="4">
          <div class="step-circle">4</div>
          <div class="step-label">
            <span class="step-title">Review</span>
            <span class="step-desc">Calculate Tax</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <main class="main-content" id="calculator">
      <div class="calculator-layout">
        <!-- Left Column: Form -->
        <div class="calculator-form">
          <form id="tax-form">
            <!-- Step 1: Tax Regime -->
            <div class="form-section" id="regime-section">
              <div class="section-header">
                <span class="section-step">Step 1</span>
                <h2 class="section-title">Select Tax Regime</h2>
                <p class="section-desc">Choose the tax regime that suits you best</p>
              </div>

              <div class="regime-cards" role="radiogroup" aria-label="Tax regime selection">
                <label class="regime-card selected" data-regime="old">
                  <input type="radio" name="tax-regime" value="old" id="regime-old" checked>
                  <div class="regime-card-content">
                    <div class="regime-check">✓</div>
                    <span class="regime-badge">Recommended</span>
                    <h3 class="regime-name">Old Tax Regime</h3>
                    <p class="regime-desc">Benefit from deductions and exemptions</p>
                  </div>
                </label>
                <label class="regime-card" data-regime="new">
                  <input type="radio" name="tax-regime" value="new" id="regime-new">
                  <div class="regime-card-content">
                    <div class="regime-check">✓</div>
                    <h3 class="regime-name">New Tax Regime</h3>
                    <p class="regime-desc">Lower tax rates, fewer deductions</p>
                  </div>
                </label>
                <label class="regime-card" data-regime="compare" style="display: none;">
                  <input type="radio" name="tax-regime" value="compare" id="regime-compare">
                  <div class="regime-card-content">
                    <div class="regime-check">✓</div>
                    <h3 class="regime-name">Compare Both</h3>
                    <p class="regime-desc">See which is better for you</p>
                  </div>
                </label>
              </div>

              <!-- Financial Year Selection -->
              <div class="fy-selector">
                <div class="fy-card">
                  <span class="fy-icon">📅</span>
                  <div class="fy-content">
                    <select id="financial-year" name="financial-year" required>
                      <option value="2024-25">2024-25 (AY 2025-26)</option>
                    </select>
                    <span class="fy-label">Assessment Year 2025-26</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Step 2: Income Details -->
            <div class="form-section" id="income-section">
              <div class="section-header">
                <span class="section-step">Step 2</span>
                <h2 class="section-title">Income Details</h2>
                <p class="section-desc">Enter your total annual income from all sources</p>
              </div>

              <div class="income-fields">
                <!-- Salary Income -->
                <div class="income-field" data-field="salary">
                  <div class="field-icon">₹</div>
                  <div class="field-content">
                    <label for="salary">Salary Income</label>
                    <input type="number" id="salary" name="salary" placeholder="0" min="0" step="1">
                    <small>Annual salary before deductions</small>
                  </div>
                </div>

                <!-- House Property Income -->
                <div class="income-field" data-field="houseProperty">
                  <div class="field-icon">🏠</div>
                  <div class="field-content">
                    <label for="house-property">House Property Income</label>
                    <input type="number" id="house-property" name="house-property" placeholder="0" step="1">
                    <small>Net income from house property</small>
                  </div>
                </div>

                <!-- Business Income -->
                <div class="income-field" data-field="business">
                  <div class="field-icon">💼</div>
                  <div class="field-content">
                    <label for="business-income">Business/Professional Income</label>
                    <input type="number" id="business-income" name="business-income" placeholder="0" min="0" step="1">
                    <small>Income from business or profession</small>
                  </div>
                </div>

                <!-- Short Term Capital Gains -->
                <div class="income-field" data-field="stcgEquity">
                  <div class="field-icon">📈</div>
                  <div class="field-content">
                    <label for="stcg-equity">Short Term Capital Gains</label>
                    <input type="number" id="stcg-equity" name="stcg-equity" placeholder="0" min="0" step="1">
                    <small>STCG from equity, mutual funds, etc.</small>
                  </div>
                </div>

                <!-- Long Term Capital Gains -->
                <div class="income-field" data-field="ltcgEquity">
                  <div class="field-icon">📊</div>
                  <div class="field-content">
                    <label for="ltcg-equity">Long Term Capital Gains</label>
                    <input type="number" id="ltcg-equity" name="ltcg-equity" placeholder="0" min="0" step="1">
                    <small>LTCG from equity, mutual funds, etc.</small>
                  </div>
                </div>

                <!-- Speculative Gains -->
                <div class="income-field" data-field="speculativeGains">
                  <div class="field-icon">📈</div>
                  <div class="field-content">
                    <label for="speculative-gains">Speculative Gains</label>
                    <input type="number" id="speculative-gains" name="speculative-gains" placeholder="0" min="0" step="1">
                    <small>Income from speculative transactions</small>
                  </div>
                </div>

                <!-- F&O Gains -->
                <div class="income-field" data-field="fnoGains">
                  <div class="field-icon">F</div>
                  <div class="field-content">
                    <label for="fno-gains">F&O Gains</label>
                    <input type="number" id="fno-gains" name="fno-gains" placeholder="0" min="0" step="1">
                    <small>Futures & Options trading gains</small>
                  </div>
                </div>

                <!-- Other Income -->
                <div class="income-field" data-field="interestIncome">
                  <div class="field-icon">•••</div>
                  <div class="field-content">
                    <label for="interest-income">Other Income</label>
                    <input type="number" id="interest-income" name="interest-income" placeholder="0" min="0" step="1">
                    <small>Interest, dividends, other income</small>
                  </div>
                </div>
              </div>

              <button type="button" class="continue-btn" id="continue-to-deductions">
                Continue to Deductions →
              </button>
            </div>

            <!-- Step 3: Deductions (Hidden by default, shown after Continue) -->
            <div class="form-section hidden" id="deductions-section">
              <div class="section-header">
                <span class="section-step">Step 3</span>
                <h2 class="section-title">Deductions</h2>
                <p class="section-desc">Enter your tax-saving deductions (Old Regime benefits most)</p>
              </div>

              <div class="deduction-fields">
                <!-- 80C -->
                <div class="deduction-field" data-field="section80C">
                  <label for="section-80c">Section 80C (Max ₹1,50,000)</label>
                  <input type="number" id="section-80c" name="section-80c" placeholder="0" min="0" max="150000" step="1">
                  <small>PPF, ELSS, LIC, etc.</small>
                </div>

                <!-- 80CCD(1B) -->
                <div class="deduction-field" data-field="section80CCD1B">
                  <label for="section-80ccd1b">Section 80CCD(1B) (Max ₹50,000)</label>
                  <input type="number" id="section-80ccd1b" name="section-80ccd1b" placeholder="0" min="0" max="50000" step="1">
                  <small>Additional NPS contribution</small>
                </div>

                <!-- 80D -->
                <div class="deduction-field" data-field="section80D">
                  <label for="section-80d">Section 80D (Medical Insurance)</label>
                  <input type="number" id="section-80d" name="section-80d" placeholder="0" min="0" max="100000" step="1">
                  <small>Health insurance premium</small>
                </div>

                <!-- 80E -->
                <div class="deduction-field" data-field="section80E">
                  <label for="section-80e">Section 80E (Education Loan)</label>
                  <input type="number" id="section-80e" name="section-80e" placeholder="0" min="0" step="1">
                  <small>Education loan interest</small>
                </div>

                <!-- 80G -->
                <div class="deduction-field" data-field="section80G">
                  <label for="section-80g">Section 80G (Donations)</label>
                  <input type="number" id="section-80g" name="section-80g" placeholder="0" min="0" step="1">
                  <small>Charitable donations</small>
                </div>

                <!-- 80TTA -->
                <div class="deduction-field" data-field="section80TTA">
                  <label for="section-80tta">Section 80TTA (Max ₹10,000)</label>
                  <input type="number" id="section-80tta" name="section-80tta" placeholder="0" min="0" max="10000" step="1">
                  <small>Savings account interest</small>
                </div>

                <!-- HRA -->
                <div class="deduction-field" data-field="hra">
                  <label for="hra">HRA Exemption</label>
                  <input type="number" id="hra" name="hra" placeholder="0" min="0" step="1">
                  <small>House Rent Allowance</small>
                </div>

                <!-- Home Loan Interest -->
                <div class="deduction-field" data-field="homeLoanInterest">
                  <label for="home-loan-interest">Home Loan Interest (Max ₹2,00,000)</label>
                  <input type="number" id="home-loan-interest" name="home-loan-interest" placeholder="0" min="0" max="200000" step="1">
                  <small>Section 24b - Self-occupied</small>
                </div>
              </div>

              <div class="form-actions">
                <button type="submit" class="calculate-btn">Calculate Tax</button>
                <button type="reset" class="reset-btn">Clear All</button>
              </div>
            </div>

            <!-- Hidden fields for backward compatibility -->
            <div style="display: none;">
              <input type="number" id="capital-gains" name="capital-gains" data-field="capitalGains">
              <input type="number" id="other-income" name="other-income" data-field="otherIncome">
              <input type="number" id="stcg-other" name="stcg-other" data-field="stcgOther">
              <input type="number" id="ltcg-other" name="ltcg-other" data-field="ltcgOther">
              <input type="number" id="speculative-losses" name="speculative-losses" data-field="speculativeLosses">
              <input type="number" id="fno-losses" name="fno-losses" data-field="fnoLosses">
              <input type="number" id="dividend-income" name="dividend-income" data-field="dividendIncome">
              <input type="number" id="other-taxable" name="other-taxable" data-field="otherTaxable">
              <input type="number" id="standard-deduction" name="standard-deduction" data-field="standardDeduction">
              <input type="number" id="section-80ttb" name="section-80ttb" data-field="section80TTB">
              <input type="number" id="lta" name="lta" data-field="lta">
              <input type="number" id="other-deductions" name="other-deductions" data-field="otherDeductions">
            </div>

            <div id="validation-errors" class="validation-errors" style="display: none;"></div>
          </form>
        </div>

        <!-- Right Column: Tax Summary -->
        <aside class="tax-summary-panel">
          <div class="summary-card">
            <h3 class="summary-title">📊 Tax Summary</h3>
            <p class="summary-placeholder" id="summary-placeholder">Choose a regime and enter income to see tax summary</p>

            <!-- Quick Comparison -->
            <div class="quick-comparison" id="quick-comparison" style="display: none;">
              <h4>Quick Comparison</h4>
              <div class="comparison-boxes">
                <div class="comparison-box old">
                  <span class="comparison-label">Old Regime</span>
                  <span class="comparison-value" id="old-quick-tax">—</span>
                </div>
                <span class="vs-text">vs</span>
                <div class="comparison-box new">
                  <span class="comparison-label">New Regime</span>
                  <span class="comparison-value" id="new-quick-tax">—</span>
                </div>
              </div>
            </div>

            <!-- Tax Breakdown -->
            <div class="tax-breakdown" id="tax-breakdown" style="display: none;">
              <h4>Tax Breakdown</h4>
              <div class="breakdown-row">
                <span class="breakdown-label">Gross Total Income</span>
                <span class="breakdown-value" id="gross-income">₹0</span>
              </div>
              <div class="breakdown-row">
                <span class="breakdown-label">Total Deductions</span>
                <span class="breakdown-value" id="total-deductions">₹0</span>
              </div>
              <div class="breakdown-row highlight">
                <span class="breakdown-label">Taxable Income</span>
                <span class="breakdown-value" id="taxable-income">₹0</span>
              </div>
              <div class="breakdown-row">
                <span class="breakdown-label">Income Tax</span>
                <span class="breakdown-value" id="income-tax">₹0</span>
              </div>
              <div class="breakdown-row">
                <span class="breakdown-label">Rebate u/s 87A</span>
                <span class="breakdown-value" id="rebate">₹0</span>
              </div>
              <div class="breakdown-row">
                <span class="breakdown-label">Surcharge</span>
                <span class="breakdown-value" id="surcharge">₹0</span>
              </div>
              <div class="breakdown-row">
                <span class="breakdown-label">Health & Education Cess (4%)</span>
                <span class="breakdown-value" id="cess">₹0</span>
              </div>
              <div class="breakdown-row total">
                <span class="breakdown-label">Total Tax Payable</span>
                <span class="breakdown-value" id="total-tax">₹0</span>
              </div>
            </div>

            <!-- You Save Section -->
            <div class="you-save" id="you-save-section" style="display: none;">
              <div class="save-icon">🐷</div>
              <div class="save-content">
                <span class="save-label">You Save</span>
                <span class="save-amount" id="savings-amount">₹0</span>
                <span class="save-regime" id="better-regime">with Old Regime</span>
              </div>
            </div>

            <!-- Important Note -->
            <div class="important-note">
              <span class="note-icon">ℹ️</span>
              <p>This calculator provides estimates based on FY 2024-25 tax slabs. Consult a tax professional for personalized advice.</p>
            </div>
          </div>
        </aside>
      </div>
    </main>

    <!-- Results Section (shown after calculation) -->
    <section class="results-section" id="results-section" style="display: none;">
      <div class="results-container">
        <h2>Tax Calculation Results</h2>
        
        <div class="comparison-container">
          <div class="regime-column">
            <h3>Old Regime</h3>
            <div class="result-item">
              <span class="result-label">Gross Income:</span>
              <span class="result-value" id="old-gross-income">₹0</span>
            </div>
            <div class="result-item">
              <span class="result-label">Taxable Income:</span>
              <span class="result-value" id="old-taxable-income">₹0</span>
            </div>
            <div class="result-item">
              <span class="result-label">Income Tax:</span>
              <span class="result-value" id="old-income-tax">₹0</span>
            </div>
            <div class="result-item">
              <span class="result-label">Surcharge:</span>
              <span class="result-value" id="old-surcharge">₹0</span>
            </div>
            <div class="result-item">
              <span class="result-label">Health & Education Cess:</span>
              <span class="result-value" id="old-cess">₹0</span>
            </div>
            <div class="result-item result-total">
              <span class="result-label">Total Tax:</span>
              <span class="result-value" id="old-total-tax">₹0</span>
            </div>
          </div>

          <div class="regime-column">
            <h3>New Regime</h3>
            <div class="result-item">
              <span class="result-label">Gross Income:</span>
              <span class="result-value" id="new-gross-income">₹0</span>
            </div>
            <div class="result-item">
              <span class="result-label">Taxable Income:</span>
              <span class="result-value" id="new-taxable-income">₹0</span>
            </div>
            <div class="result-item">
              <span class="result-label">Income Tax:</span>
              <span class="result-value" id="new-income-tax">₹0</span>
            </div>
            <div class="result-item">
              <span class="result-label">Surcharge:</span>
              <span class="result-value" id="new-surcharge">₹0</span>
            </div>
            <div class="result-item">
              <span class="result-label">Health & Education Cess:</span>
              <span class="result-value" id="new-cess">₹0</span>
            </div>
            <div class="result-item result-total">
              <span class="result-label">Total Tax:</span>
              <span class="result-value" id="new-total-tax">₹0</span>
            </div>
          </div>
        </div>

        <div class="comparison-summary">
          <h3>Comparison Summary</h3>
          <div class="result-item result-highlight">
            <span class="result-label">Tax Difference:</span>
            <span class="result-value" id="tax-difference">₹0</span>
          </div>
          <div class="result-item">
            <span class="result-label">More Beneficial Regime:</span>
            <span class="result-value" id="beneficial-regime">-</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <section class="features-section" id="guide">
      <div class="features-container">
        <h2 class="features-title">Why Use Our Tax Calculator?</h2>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">🛡️</div>
            <h3>100% Secure</h3>
            <p>Your data never leaves your browser</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">⚡</div>
            <h3>Instant Results</h3>
            <p>Get calculations in real-time</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">✓</div>
            <h3>Accurate Calculation</h3>
            <p>Based on latest FY 2024-25 tax slabs</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">📱</div>
            <h3>Mobile Friendly</h3>
            <p>Works perfectly on all devices</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">✓</div>
            <h3>Free to Use</h3>
            <p>No registration or fees required</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="site-footer" id="about">
      <div class="footer-container">
        <div class="footer-grid">
          <!-- Logo & Social -->
          <div class="footer-brand">
            <div class="footer-logo">
              <span class="logo-icon">📊</span>
              <span class="logo-text">Tax Calculator</span>
            </div>
            <p class="footer-desc">Simplifying tax calculations for Indian taxpayers since 2024.</p>
            <div class="social-links">
              <a href="#" aria-label="Facebook">f</a>
              <a href="#" aria-label="Twitter">𝕏</a>
              <a href="#" aria-label="LinkedIn">in</a>
              <a href="#" aria-label="Instagram">📷</a>
            </div>
          </div>

          <!-- Quick Links -->
          <div class="footer-links">
            <h4>Quick Links</h4>
            <ul>
              <li><a href="#calculator">Calculator</a></li>
              <li><a href="#comparison">Old vs New Regime</a></li>
              <li><a href="#guide">Tax Guide</a></li>
              <li><a href="#about">About Us</a></li>
              <li><a href="#disclaimer">Disclaimer</a></li>
            </ul>
          </div>

          <!-- Important Info -->
          <div class="footer-links">
            <h4>Important Info</h4>
            <ul>
              <li><a href="https://www.incometax.gov.in" target="_blank" rel="noopener">Income Tax Department</a></li>
              <li><a href="https://www.incometax.gov.in/iec/foportal/" target="_blank" rel="noopener">Tax E-Filing Portal</a></li>
              <li><a href="https://incometaxindia.gov.in/Pages/Circulars-Notifications.aspx" target="_blank" rel="noopener">CBDT Notifications</a></li>
              <li><a href="#budget">Budget 2024-25</a></li>
            </ul>
          </div>

          <!-- Contact -->
          <div class="footer-contact">
            <h4>Contact Developer</h4>
            <p class="contact-name">Rajesh Jaiswal</p>
            <p class="contact-email">📧 contact@taxcalculator.in</p>
            <p class="contact-phone">📞 +91-XXXXXXXXXX</p>
          </div>
        </div>

        <div class="footer-bottom">
          <p>&copy; 2024 Indian Income Tax Calculator. For informational purposes only.</p>
          <p>Made with ❤️ for Indian Taxpayers</p>
        </div>
      </div>
    </footer>
  </div>

  <script type="module" src="src/app/main.js"></script>
</body>
</html>
