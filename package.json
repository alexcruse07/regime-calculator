{
  "name": "indian-income-tax-calculator",
  "version": "0.1.0",
  "description": "Static web application to compare income tax liability between old and new tax regimes",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "serve": "http-server -p 8080",
    "dev": "npm run serve"
  },
  "keywords": [
    "india",
    "tax",
    "income",
    "calculator",
    "old-regime",
    "new-regime"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.52.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.1",
    "vitest": "^1.0.0"
  }
}
